# Configurações do PostgreSQL
db.driver=org.postgresql.Driver
db.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:todolist}
db.user=${DB_USER:todolist_user}
db.password=${DB_PASSWORD:todolist_pass}

# Configurações do Hibernate
hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
hibernate.show_sql=false
hibernate.format_sql=true
hibernate.hbm2ddl.auto=update

# Configurações do Redis
redis.host=${REDIS_HOST:localhost}
redis.port=${REDIS_PORT:6379}

# Configurações do MongoDB
mongo.uri=mongodb://${MONGO_HOST:localhost}:${MONGO_PORT:27017}
mongo.database=${MONGO_DATABASE:todolist_logs}
