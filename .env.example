# PostgreSQL
POSTGRES_DB=todolist
POSTGRES_USER=todolist_user
POSTGRES_PASSWORD=change_me_please_123

# Redis
REDIS_PASSWORD=change_me_redis_456

# MongoDB
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo_789
MONGO_INITDB_DATABASE=todolist_logs

# JVM Settings (opcional)
JAVA_TOOL_OPTIONS=-Xmx512m -Xms256m

